# Application Environment Configuration
# Copy this file to .env and adjust values for your local environment.
# NEVER commit .env to source control!

PROJECT_NAME="AI Resume Analyzer & Job Matching System"
ENVIRONMENT="development"
DEBUG=true

# API Server
API_HOST="0.0.0.0"
API_PORT=8000
API_BASE_URL="http://localhost:8000/api"

# Database (PostgreSQL)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/resume_analyzer"
TEST_DATABASE_URL="sqlite:///./test.db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Vector Store (ChromaDB)
CHROMA_HOST="localhost"
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY="./chroma_data"

# LLM (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# File Storage & Limits
TEMP_STORAGE_DIR="./temp_storage"
MAX_RESUME_SIZE_MB=10
MAX_ACCEPTED_RESUMES=50
TEMP_FILE_RETENTION_HOURS=24
WATCHDOG_INTERVAL_SECONDS=300
RESUME_CLAIM_TIMEOUT_SECONDS=600
EXPLANATION_TIMEOUT_SECONDS=120
